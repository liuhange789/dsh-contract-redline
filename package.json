{
  "name": "@liuhange/dsh-contract-redline",
  "version": "0.1.4",
  "description": "Contract risk quick-scan for small businesses: paste a procurement, lease or service contract and get a checklist of high-risk clauses, one-sided obligations and missing key clauses — rule-based, local-only, no legal advice. 合同风险速查：粘贴合同文本，逐条标出高风险条款、权利义务不对等与缺失的关键条款。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "contract",
    "contract-review",
    "legal",
    "risk",
    "clause",
    "合同",
    "合同审查",
    "风险条款",
    "条款扫描",
    "procurement",
    "lease",
    "中小企业",
    "合同风险"
  ],
  "homepage": "https://github.com/liuhange789/dsh-contract-redline#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liuhange789/dsh-contract-redline.git"
  },
  "bugs": {
    "url": "https://github.com/liuhange789/dsh-contract-redline/issues"
  },
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/scan.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7 <0.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "author": "liuhange"
}
